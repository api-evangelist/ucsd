{
  "opencollection": "1.0.0",
  "info": {
    "name": "TritonAI Developer API (LiteLLM Gateway) audio completions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "completions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://tritonai-api.ucsd.edu/v1/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a text completion for the provided prompt and model."
        }
      ]
    }
  ],
  "bundled": true
}